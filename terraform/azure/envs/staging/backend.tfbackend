# envs/staging/backend.tfbackend — Terraform remote-state config for staging.
# Usage:
#   terraform init -backend-config=envs/staging/backend.tfbackend
resource_group_name  = "outrena-tfstate-rg"
storage_account_name = "outrenatfstate"
container_name       = "tfstate"
key                  = "azure/staging.terraform.tfstate"
