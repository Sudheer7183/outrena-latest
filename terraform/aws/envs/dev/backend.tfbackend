# envs/dev/backend.tfbackend — S3 remote state config for dev.
#
# Usage:
#   terraform init \
#     -backend-config=envs/dev/backend.tfbackend
#
# State is stored in a shared org-level S3 bucket (`outrena-tfstate-dev`),
# one key per environment per cloud. S3 native locking (use_lockfile=true
# in versions.tf) prevents concurrent `apply` without a DynamoDB table.

bucket       = "outrena-tfstate-dev"
key          = "aws/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
