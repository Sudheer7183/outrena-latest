{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OUTRENA — per-user + per-tenant cost + usage tracking. Backed by Prometheus (outrena_llm_cost_cents_total, outrena_emails_sent_total). Use this to answer 'who is spending what?'",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Total Cost over Time (per tenant + per user)",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LLM Cost per Tenant (cents/min, cumulative)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant) (rate(outrena_llm_cost_cents_total[5m])) * 60",
          "legendFormat": "{{tenant}}",
          "interval": "",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cent",
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 10, "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Email Send Rate per Tenant (sends/min)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant) (rate(outrena_emails_sent_total[5m])) * 60",
          "legendFormat": "{{tenant}}",
          "interval": "",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "row",
      "title": "Cost by Event Type + Top 10 Users",
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Cost Breakdown by Event Type (last 1h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (provider) (increase(outrena_llm_cost_cents_total[1h]))",
          "legendFormat": "{{provider}}",
          "interval": "",
          "format": "time_series",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant) (increase(outrena_emails_sent_total[1h]))",
          "legendFormat": "emails/{{tenant}}",
          "interval": "",
          "format": "time_series",
          "instant": true,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"pieType": "donut", "displayLabels": ["name", "percent"], "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}}
    },
    {
      "type": "barchart",
      "title": "Top 10 Users by Email Send Rate (sends/min)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "topk(10, sum by (user_id, tenant) (rate(outrena_emails_sent_total[5m])) * 60)",
          "legendFormat": "{{tenant}} / {{user_id}}",
          "interval": "",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"orientation": "horizontal", "xField": "user_id", "yField": "Value", "showValue": "always"}
    },
    {
      "type": "row",
      "title": "Cost Trend vs Budget",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cumulative LLM Cost This Month (cents) vs Monthly Budget",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 9},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant) (outrena_llm_cost_cents_total)",
          "legendFormat": "actual: {{tenant}}",
          "interval": "",
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100000", 
          "legendFormat": "budget: $1000/mo",
          "interval": "",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cent",
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50000}, {"color": "red", "value": 100000}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "budget: $1000/mo"},
            "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "stat",
      "title": "Total LLM Cost Today (USD)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 28, "w": 6, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(outrena_llm_cost_cents_total[24h])) / 100",
          "interval": "",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat",
      "title": "Total LLM Calls Today",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 28, "w": 6, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(outrena_llm_calls_total[24h]))",
          "interval": "",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}},
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat",
      "title": "Total Emails Sent Today",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 28, "w": 6, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(outrena_emails_sent_total[24h]))",
          "interval": "",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}},
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat",
      "title": "Email Bounce Rate (last 1h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 28, "w": 6, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(outrena_email_bounces_total[1h])) / clamp_min(sum(rate(outrena_emails_sent_total[1h])), 1) * 100",
          "interval": "",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}},
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["outrena", "cost", "usage", "finops"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "label": "Prometheus datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]},
  "timezone": "browser",
  "title": "OUTRENA — Cost & Usage",
  "uid": "outrena-cost-usage",
  "version": 1,
  "weekStart": ""
}
