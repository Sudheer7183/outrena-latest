# Vite env vars (exposed to the browser — NEVER put secrets here)
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=outrena
VITE_KEYCLOAK_CLIENT_ID=frontend

# Local dev: bypass Keycloak and use a mock TENANT_ADMIN session.
# Leave empty in any deployed environment.
VITE_DEV_BYPASS_AUTH=false

# Local dev: pin a tenant schema without Keycloak tenant_slug claim.
# Leave empty when Keycloak is issuing real tokens.
VITE_DEV_TENANT_SLUG=

# PostHog product analytics (Tech Doc §12.2). Leave empty to disable —
# analytics + session replay are a no-op without a key (dev/CI safe).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
